[
    {
        "type": "function",
        "function": {
            "name": "scheduleAppointment",
            "description": "Books a dental appointment after collecting all necessary information",
            "parameters": {
                "type": "object",
                "properties": {
                    "patientName": {
                        "type": "string",
                        "description": "Full name of the patient"
                    },
                    "phoneNumber": {
                        "type": "string",
                        "description": "Patient's phone number"
                    },
                    "email": {
                        "type": "string",
                        "description": "Patient's email address"
                    },
                    "appointmentType": {
                        "type": "string",
                        "enum": [
                            "cleaning",
                            "consultation",
                            "filling",
                            "crown",
                            "root_canal",
                            "emergency",
                            "cosmetic",
                            "other"
                        ],
                        "description": "Type of dental appointment"
                    },
                    "preferredDate": {
                        "type": "string",
                        "description": "Patient's preferred appointment date"
                    },
                    "preferredTime": {
                        "type": "string",
                        "description": "Patient's preferred appointment time"
                    },
                    "isNewPatient": {
                        "type": "boolean",
                        "description": "Whether this is a new patient"
                    },
                    "insuranceProvider": {
                        "type": "string",
                        "description": "Patient's dental insurance provider if applicable"
                    },
                    "notes": {
                        "type": "string",
                        "description": "Any additional notes or special requests"
                    }
                },
                "required": [
                    "patientName",
                    "phoneNumber",
                    "appointmentType",
                    "isNewPatient"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "checkAvailability",
            "description": "Checks available appointment slots for a given date",
            "parameters": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "description": "Date to check availability (YYYY-MM-DD)"
                    },
                    "appointmentType": {
                        "type": "string",
                        "description": "Type of appointment to check duration"
                    }
                },
                "required": [
                    "date"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "transferCall",
            "description": "Transfers the call to appropriate department",
            "parameters": {
                "type": "object",
                "properties": {
                    "department": {
                        "type": "string",
                        "enum": [
                            "scheduling",
                            "billing",
                            "emergency",
                            "general"
                        ],
                        "description": "Department to transfer to"
                    },
                    "reason": {
                        "type": "string",
                        "description": "Reason for transfer"
                    }
                },
                "required": [
                    "department"
                ]
            }
        }
    }
]